<?xml version="1.0"?>
<ruleset name="iG Syntax Hiliter">

	<description>Coding standards for the iG:Syntax Hiliter plugin.</description>

	<!--
		#############################################################################
		FILES TO CHECK
		#############################################################################

		Between them these paths hold every PHP file the repo tracks, so a new
		file is covered without this list being touched and has to be clean from
		the start. The rule set is never weakened to let a file in; generated and
		vendored PHP, such as build/block/index.asset.php, is excluded further
		down.
	-->
	<file>classes</file>
	<file>tests</file>
	<file>templates</file>
	<file>ig-syntax-hiliter.php</file>
	<file>autoloader.php</file>
	<file>uninstall.php</file>

	<!--
		#############################################################################
		COMMAND LINE DEFAULTS
		#############################################################################
	-->
	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="cache" value=".phpcs.cache"/>
	<arg name="tab-width" value="4"/>
	<arg name="colors"/>
	<arg value="sp"/><!-- Show sniff codes and progress. -->

	<!--
		#############################################################################
		PATHS THAT ARE NEVER CHECKED
		#############################################################################
	-->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<!-- Generated output: build/ (wp-scripts) and assets/build/ (sass, terser).
	     The pattern is unanchored, so the one line covers both. -->
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/assets/lib/*</exclude-pattern><!-- Vendored Prism.js. -->
	<exclude-pattern>*/.scratchpad/*</exclude-pattern>

	<!--
		#############################################################################
		RULE SETS
		#############################################################################

		`WordPress` is the umbrella standard — it is exactly WordPress-Core +
		WordPress-Docs + WordPress-Extra. It is referenced as one ruleset rather
		than three so that additions WPCS makes to the umbrella are picked up
		automatically instead of being silently missed.
	-->
	<rule ref="WordPress"/>

	<!-- Flag anything that is not valid on the plugin's minimum PHP version and up. -->
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.4-"/>

	<!-- Minimum WordPress version the plugin supports. -->
	<config name="minimum_wp_version" value="6.9"/>

	<!--
		#############################################################################
		SNIFF CONFIGURATION
		#############################################################################
	-->

	<!-- Tabs for indentation, never spaces. -->
	<rule ref="Generic.WhiteSpace.DisallowSpaceIndent"/>
	<rule ref="Universal.WhiteSpace.PrecisionAlignment">
		<properties>
			<property name="ignoreAlignmentBefore" type="array">
				<element value="T_COMMENT"/>
				<element value="T_DOC_COMMENT_WHITESPACE"/>
			</property>
		</properties>
	</rule>

	<!-- Spaces inside parentheses: foo( $bar ) — this is WPCS default, stated explicitly. -->
	<rule ref="WordPress.WhiteSpace.ControlStructureSpacing">
		<properties>
			<property name="blank_line_check" value="false"/>
		</properties>
	</rule>

	<!--
		Every file in this plugin ends with a `//EOF` marker and every class with
		a `//end of class` marker. That is a deliberate, long standing signature
		of this codebase, so the two sniffs that object to the spacing and the
		punctuation of those markers are switched off. Everything else the
		inline comment sniff checks stays on.
	-->
	<rule ref="Squiz.Commenting.InlineComment.NoSpaceBefore">
		<severity>0</severity>
	</rule>
	<rule ref="Squiz.Commenting.InlineComment.InvalidEndChar">
		<severity>0</severity>
	</rule>

	<!--
		This codebase writes functions and classes "airily" — a blank line after the
		opening brace and before the closing one. That is house style throughout the
		plugin, so the two whitespace sniffs that object to it are switched off. Drop
		these two exclusions if the house style is ever changed.
	-->
	<rule ref="PSR2.Methods.FunctionClosingBrace.SpacingBeforeClose">
		<severity>0</severity>
	</rule>
	<rule ref="PSR2.Classes.ClassDeclaration.CloseBraceAfterBody">
		<severity>0</severity>
	</rule>

	<!-- Text domain used by every translation function in the plugin. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="igsyntax-hiliter"/>
			</property>
		</properties>
	</rule>

	<!-- Everything global must carry one of the plugin's prefixes. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ig_syntax_hiliter"/>
				<element value="IG_SYNTAX_HILITER"/>
				<element value="iG\Syntax_Hiliter"/>
			</property>
		</properties>
	</rule>

	<!--
		#############################################################################
		PER PATH EXCEPTIONS
		#############################################################################
	-->

	<!-- Short array syntax is the house style, and it is enforced: WPCS's mandate for
	     `array()` is switched off and the opposite rule is switched on in its place. -->
	<rule ref="Universal.Arrays.DisallowShortArraySyntax">
		<severity>0</severity>
	</rule>
	<rule ref="Generic.Arrays.DisallowLongArraySyntax"/>

	<!-- A leading underscore marks a protected member. The visibility keyword is
	     always present as well. -->
	<rule ref="PSR2.Classes.PropertyDeclaration.Underscore">
		<severity>0</severity>
	</rule>
	<rule ref="PSR2.Methods.MethodDeclaration.Underscore">
		<severity>0</severity>
	</rule>

	<!-- Methods close with a `}    //end method_name()` marker. WPCS excludes this
	     sniff's `.Missing` code but not `.Misplaced`. -->
	<rule ref="Squiz.Commenting.ClosingDeclarationComment.Misplaced">
		<severity>0</severity>
	</rule>

	<!-- The `iG` branding starts lowercase. -->
	<rule ref="PEAR.NamingConventions.ValidClassName.StartWithCapital">
		<exclude-pattern>*/classes/class-ig-syntax-hiliter-gatekeeper.php</exclude-pattern>
	</rule>

	<!--
		Test bootstraps run before WordPress exists, or instead of it. WP_Filesystem
		is not available to them and STDERR is the only way they can report a
		misconfiguration, so the alternative-functions sniff does not apply.
	-->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>*/tests/*wp-tests-config.php</exclude-pattern>
	</rule>

</ruleset>
