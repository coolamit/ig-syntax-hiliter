<?xml version="1.0" encoding="UTF-8"?>
<!--
	PHPUnit is pinned to 9.6 because the WordPress test library still calls
	PHPUnit 9 only APIs (`PHPUnit\Util\Test::parseTestMethodAnnotations()` and
	`TestCase::getName()` in includes/abstract-testcase.php), which PHPUnit 10
	removed — every integration test errors out on PHPUnit 10 and up. Move both
	the version and this config file forward once WordPress core supports it.

	`make test-unit` / `make test-integration` map to the two suites below.
	Running the `phpunit` binary without naming a test suite is rejected by
	tests/bootstrap.php, because each tier needs a different bootstrap.

	Test case files are named after the class they hold, eg. `Renderer_Test.php`,
	because PHPUnit resolves a test class from its file name and will not find it
	otherwise. This is the one place in the plugin that does not use kebab-case
	file names.
-->
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
	bootstrap="tests/bootstrap.php"
	cacheResultFile=".phpunit.cache/test-results"
	colors="true"
	verbose="false"
	beStrictAboutOutputDuringTests="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	beStrictAboutTodoAnnotatedTests="true"
	convertDeprecationsToExceptions="true"
	convertErrorsToExceptions="true"
	convertNoticesToExceptions="true"
	convertWarningsToExceptions="true"
	failOnEmptyTestSuite="true"
	failOnIncomplete="true"
	failOnRisky="true"
	failOnWarning="true"
	>

	<testsuites>
		<!-- Pure PHP. No WordPress, no database. -->
		<testsuite name="unit">
			<directory suffix="Test.php">tests/unit</directory>
		</testsuite>

		<!-- Runs against a real WordPress install and the wordpress_unit_tests database. -->
		<testsuite name="integration">
			<directory suffix="Test.php">tests/integration</directory>
		</testsuite>
	</testsuites>

	<coverage>
		<include>
			<directory suffix=".php">classes</directory>
			<file>autoloader.php</file>
			<file>ig-syntax-hiliter.php</file>
		</include>
		<exclude>
			<file>classes/geshi.php</file>
			<directory suffix=".php">geshi</directory>
		</exclude>
	</coverage>

</phpunit>
